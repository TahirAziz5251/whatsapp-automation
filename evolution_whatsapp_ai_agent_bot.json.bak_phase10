              "name": "apikey",
              "value": "={{ ($('Extract Message Data').first() || $json).json?.instanceToken || 'abafe9a4-f13e-4fbb-bf88-f6c0b6bc77d6' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"number\": (($('Extract Message Data').first() || $json).json?.customerPhone || '').replace(/:[0-9]+@/, '@'),\n  \"text\": ($json.output || $json.text || 'Hello! How can I assist you today?').replace(/\\{\\{.*?\\}\\}/g, '').trim()\n}) }}"
      },
