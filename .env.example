# ==============================================================================
# MASTER BACKEND ENVIRONMENT CONFIGURATION (STANDARDIZED TEMPLATE)
# Dual Context: Windows Host (localhost:5432) & Docker Desktop (host.docker.internal:5432)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CLUSTER TARGETS
# ------------------------------------------------------------------------------
# Windows Host Native PostgreSQL 18
DB_HOST=localhost
DB_PORT=5432

# Docker Internal Bridge to Windows Host (used inside Docker containers like n8n)
DOCKER_DB_HOST=host.docker.internal
DOCKER_DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. MASTER / DEDICATED DOMAIN CONNECTION STRINGS (LOCAL HOST ACCESS)
# ------------------------------------------------------------------------------
# Control Plane
PLATFORM_DB_URL=postgresql://platform_app:YOUR_PLATFORM_PASSWORD@localhost:5432/platform_db

# Retail Domain
POS_DB_URL=postgresql://pos_app:YOUR_POS_PASSWORD@localhost:5432/pos_db

# Education Domain
BISE_DB_URL=postgresql://bise_app:YOUR_BISE_PASSWORD@localhost:5432/bise_db

# Healthcare Domain
HOSPITAL_DB_URL=postgresql://hospital_app:YOUR_HOSPITAL_PASSWORD@localhost:5432/hospital_db

# ------------------------------------------------------------------------------
# 3. CONTAINERIZED CONNECTION STRINGS (FOR n8n / DOCKER SERVICES)
# ------------------------------------------------------------------------------
DOCKER_PLATFORM_DB_URL=postgresql://platform_app:YOUR_PLATFORM_PASSWORD@host.docker.internal:5432/platform_db
DOCKER_POS_DB_URL=postgresql://pos_app:YOUR_POS_PASSWORD@host.docker.internal:5432/pos_db
DOCKER_BISE_DB_URL=postgresql://bise_app:YOUR_BISE_PASSWORD@host.docker.internal:5432/bise_db
DOCKER_HOSPITAL_DB_URL=postgresql://hospital_app:YOUR_HOSPITAL_PASSWORD@host.docker.internal:5432/hospital_db

# ------------------------------------------------------------------------------
# 4. LEAST-PRIVILEGE GATEWAY CONNECTION STRINGS (AI AGENT & SAFE TOOL ACCESS)
# ------------------------------------------------------------------------------
# Read-Only Gateway Role (Default Password: gateway_secure_readonly_2026)
GATEWAY_READONLY_PLATFORM_URL=postgresql://gateway_readonly:gateway_secure_readonly_2026@localhost:5432/platform_db
GATEWAY_READONLY_POS_URL=postgresql://gateway_readonly:gateway_secure_readonly_2026@localhost:5432/pos_db
GATEWAY_READONLY_BISE_URL=postgresql://gateway_readonly:gateway_secure_readonly_2026@localhost:5432/bise_db
GATEWAY_READONLY_HOSPITAL_URL=postgresql://gateway_readonly:gateway_secure_readonly_2026@localhost:5432/hospital_db

# Action Gateway Writer Role (Default Password: gateway_action_writer_2026)
GATEWAY_ACTION_WRITER_PLATFORM_URL=postgresql://gateway_action_writer:gateway_action_writer_2026@localhost:5432/platform_db
GATEWAY_ACTION_WRITER_POS_URL=postgresql://gateway_action_writer:gateway_action_writer_2026@localhost:5432/pos_db
GATEWAY_ACTION_WRITER_BISE_URL=postgresql://gateway_action_writer:gateway_action_writer_2026@localhost:5432/bise_db
GATEWAY_ACTION_WRITER_HOSPITAL_URL=postgresql://gateway_action_writer:gateway_action_writer_2026@localhost:5432/hospital_db

# ------------------------------------------------------------------------------
# 5. CONNECTION POOLING CONFIGURATION
# ------------------------------------------------------------------------------
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 6. RUNTIME TIMEOUT & LOCKING SAFEGUARDS
# ------------------------------------------------------------------------------
# Maximum query runtime before forced cancellation (15 seconds)
DB_STATEMENT_TIMEOUT_MS=15000

# Maximum lock acquisition wait time (5 seconds)
DB_LOCK_TIMEOUT_MS=5000

# Maximum idle-in-transaction duration before termination (20 seconds)
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 7. SERVICE INTEGRATION ENDPOINTS
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:4000
EVOLUTION_API_KEY=429683C4C977415CAAFCCE10F7D57E11
N8N_URL=http://localhost:5678
REDIS_URL=redis://localhost:6379
FAISS_SERVICE_URL=http://localhost:8000
