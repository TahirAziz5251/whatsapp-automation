      "position": [
        -980,
        1800
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "norm_inst",
              "name": "instance_name",
              "value": "={{ $json.body?.instance || $json.body?.body?.instance || $json.instance || 'pos-instance' }}",
              "type": "string"
            },
            {
              "id": "norm_usr",
              "name": "user_id",
              "value": "={{ (($json.body?.data || $json.body?.body?.data || $json.data)?.Info?.Sender || ($json.body?.data || $json.body?.body?.data || $json.data)?.Info?.Chat || '').replace(/[^0-9]/g, '') }}",
              "type": "string"
            },
            {
              "id": "norm_msgid",
              "name": "message_id",
              "value": "={{ ($json.body?.data || $json.body?.body?.data || $json.data)?.Info?.Id || 'MSG_' + Math.random().toString(36).substring(2, 9) }}",
