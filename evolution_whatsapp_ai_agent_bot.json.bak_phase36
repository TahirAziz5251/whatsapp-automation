              "value": "={{ (($json.body?.data || $json.body?.body?.data || $json.data)?.Info?.PushName && ($json.body?.data || $json.body?.body?.data || $json.data)?.Info?.PushName.replace(/[^\\w\\s\\u0600-\\u06FF]/g, '').trim()) || 'Customer' }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "instanceToken",
              "value": "={{ $json.body?.instanceToken || $json.body?.body?.instanceToken || $json.instanceToken || '429683C4C977415CAAFCCE10F7D57E11' }}",
